# Configuración de mitmproxy-pihole
# Copiar este archivo a `.env` y rellenar con valores reales.
# El `.env` está en `.gitignore` y NO se commitea.

# === Pi-hole ===
# IP del Pi-hole que se usará como DNS upstream
PIHOLE_DNS=192.168.1.3
PIHOLE_DNS_PORT=53

# === Proxy ===
# Puerto donde escucha mitmproxy (HTTP+HTTPS)
# Default: 3128 (puerto clásico de Squid, evita colisión con apps web)
PROXY_PORT=3128

# IP del server donde corre este compose (visible para los devices)
# Si está detrás de NAT, es la IP local de la LAN
SERVER_IP=192.168.1.4

# === Portal de onboarding ===
# Puerto donde Caddy sirve la página de descarga del cert
ONBOARDING_PORT=8081

# === Contraseña del portal (opcional) ===
# Si se deja vacío, el portal es público
# Útil para que solo devices autorizados descarguen el cert
PORTAL_PASSWORD=
